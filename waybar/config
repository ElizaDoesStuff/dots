{
	"layer": "top",
	"margin": "8 8 0 8",

	"modules-left": [ "custom/archbtw", "custom/pipewire" ],
	"modules-center": [ "river/tags" ],
	"modules-right": [ "bluetooth", "network", "battery", "clock" ],

	"custom/archbtw": {

		"format": " ",
		"id": "archbtw"

	},

	"custom/pipewire": {

		"exec": "pw-volume status",
		"return-type": "json",

		"format": "{icon} {percentage}%",
		"format-icons": {
			"mute": "󰝟 ",
			"default": [ "󰕿 ", "󰖀 ", "󰕾 " ]
		}

	},

	"river/tags": {

		"num-tags": 4

	},

	"bluetooth": {

		"format": "󰂯 {status} ({device_battery_percentage}%)"

	},

	"network": {
		
		"format": "{ifname}",
		"format-wifi": "󰖩 {essid} {signalStrength}",
		"format-ethernet": "󰈀 {ifname}"

	},

	"battery": {

		"format": "{icon} {capacity}%",
		"interval": 30

	},

	"clock": {
		
		"format": "{:%R %d.%m.%y}",
		"timezone": "America/Chicago"
	
	}

}

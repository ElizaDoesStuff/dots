* {

	font-family: Space Mono Nerd Font;
	font-size: 14px;

}

window#waybar {

	background-color: #202027;
	color: #e0ffc0;

	border-radius: 16px;

}

#workspaces button, #tags button {

	color: #e0ffc0;
	opacity: 0.25;

}

#workspaces button.active, #tags button.focused {

	color: #a0e080;
	opacity: 1;

	font-weight: bold;

}

#tags button:hover {
	
	background-color: transparent;
	color: #e0ffc0;

	opacity: 1;

}

#clock {

	padding: 0 16px;

}

#custom-archbtw {

	padding: 0 16px;

}

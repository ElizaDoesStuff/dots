include = ~/pawsoff/config/hyprland/theme

env = HYPRCURSOR_THEME, phinger-cursors-dark
env = HYPRCURSOR_SIZE, 48

env = XCURSOR_THEME, phinger-cursors-dark
env = XCURSOR_SIZE, 48

exec-once = swww-daemon
exec-once = waybar

$term    = ghostty
$editor  = ghostty --command=nvim
$browser = zen-browser

$reload  = ~/pawsoff/config/hyprland/reload

$mod   = SUPER
$left  = H
$right = L
$up    = K
$down  = J

bind = $mod, V,         exec, $term
bind = $mod, B,         exec, $editor
bind = $mod, N,         exec, $browser

bind = $mod, $left,     workspace, -1
bind = $mod, $right,    workspace, +1

bind = $mod, Q,         killactive
bind = $mod + SHIFT, Q, exit

bind = $mod, F,		fullscreen

bind = $mod, R,         exec, $reload

general {

	layout = dwindle

	border_size = 0

	gaps_in = 8
	gaps_out = 16

}

decoration {

	rounding = 16

	blur {
		enabled = false
	}

	shadow {
		enabled = false
	}

}

cursor=
phinger-cursors-dark 42

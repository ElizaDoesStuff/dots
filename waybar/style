* {

	font-family: Noto Sans Mono CJK JP, monospace;
	font-size: 14px;

	transition: 0;

}

window#waybar {

	background: transparent;
	color: black;

}

#tags button {

	background: transparent;
	border: 2px solid transparent;
	
	border-radius: 0;
	padding: 2px 2px;
	margin: 8px 2px;

	opacity: 0.5;

}

#tags button.focused {

	opacity: 1;
	font-weight: bold;

}

#custom-archbtw,
#custom-pipewire,
#bluetooth,
#network,
#battery,
#clock {

	color: black;
	padding: 0 16px;

}
